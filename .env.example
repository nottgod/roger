# Roger — configuration template.
#
#   cp .env.example .env
#
# Then fill in what you have. Nothing here is required to start: run the voice
# interview with no keys at all, and add them when you need them.
#
# .env is git-ignored. Never commit it, never paste a key into a chat or an issue.
# If a key leaks, rotating it at the provider is the only real fix.


# ─── Your CRM (optional) ──────────────────────────────────────────────────────
# No CRM? Skip this whole block and use the spreadsheet mode instead.

# Long-lived access token of your Kommo integration.
# Kommo → Settings → Integrations → your integration → Keys and scopes.
KOMMO_TOKEN=

# The first part of <this>.kommo.com, from the address bar when you are logged in.
KOMMO_SUBDOMAIN=

# Your own user id in Kommo. Roger only ever reads and writes leads that belong
# to this id — it will not touch a teammate's leads.
# Kommo → Settings → Users → click yourself → the id in the URL.
KOMMO_OWNER_ID=


# ─── Research (optional, these cost money) ────────────────────────────────────
# Without them Roger still writes, and it tells you it wrote with less context
# instead of pretending it did the homework. Every run records what it spent in
# .roger/costs.jsonl.

# Exa.ai — searches the person and the company. Paid per search.
# https://dashboard.exa.ai → API keys
EXA_KEY=

# Firecrawl — reads the company website. Paid per page.
# https://firecrawl.dev → API keys
FIRECRAWL_KEY=

# Fundable — funding signals. Paid. The most optional of the three.
# https://tryfundable.ai → API
FUNDABLE_KEY=


# ─── Roger (optional) ─────────────────────────────────────────────────────────

# Which context pack to use: a folder name under rapport/contexts/.
ROGER_CONTEXT=

# Which operator to write as: a folder name under rapport/operators/.
# The voice interview creates this for you.
ROGER_OPERATOR=

# Timezone offset in hours, used for cadence dates. Default -3.
ROGER_TZ=
